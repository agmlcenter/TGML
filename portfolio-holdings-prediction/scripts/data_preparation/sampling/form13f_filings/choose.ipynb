    "import pandas as pd\n",
    "import random\n",
    "\n",
    "df = pd.read_csv('sp500.csv')\n",
    "unique_cik = df['CIK'].unique()\n",
    "random_cik = random.sample(list(unique_cik), 100)\n",
    "df = df[df['CIK'].isin(random_cik)]\n",
    "df.to_csv('sp500_random.csv', index=False)\n",
    "print(f\"Saved {len(df)} rows to sp500_random.csv\")"
   ]
  }
